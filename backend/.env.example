# Copy this file to .env and fill in your own values.
# Never commit the real .env file to version control.

PORT=5000

# Local MongoDB (install MongoDB Community Server) or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/blockchain_voting

# Use a long random string in real use. This is just a placeholder.
JWT_SECRET=change_this_to_a_long_random_secret_string

# How long a login token stays valid
JWT_EXPIRES_IN=1d

# Frontend URL, used for CORS
CLIENT_URL=http://localhost:5173

# Admin bootstrap credentials (used once to create the first admin user, see utils/createAdmin.js)
ADMIN_VOTER_ID=admin001
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Election Admin
